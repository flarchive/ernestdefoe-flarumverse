{
    "name": "ernestdefoe/flarumverse",
    "description": "Flarumverse — Flarum forums pair with each other and show each other's new discussions on a Flarumverse page. Every link goes back to the forum it came from. No central server.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "fediverse",
        "federation",
        "cross-promotion",
        "traffic"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/flarumverse",
    "support": {
        "issues": "https://github.com/ernestdefoe/flarumverse/issues",
        "source": "https://github.com/ernestdefoe/flarumverse"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Flarumverse\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Flarumverse",
            "category": "feature",
            "icon": {
                "name": "fas fa-circle-nodes",
                "backgroundColor": "#0e7490",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/tags"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "flarum/phpstan": "^2.0"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
